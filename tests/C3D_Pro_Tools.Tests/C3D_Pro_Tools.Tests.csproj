<Project Sdk="Microsoft.NET.Sdk">
	<!-- Offline tests for the plugin's pure engines. The engine source files are compiled in by link (no reference to the
	     plugin assembly), so the tests need no AutoCAD / Civil 3D assemblies and run with plain `dotnet test`. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>C3DProTools.Tests</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- WinForms only for the preview form's offline regression test (FormCoverPreview); its implicit usings are removed below. -->
		<UseWindowsForms>true</UseWindowsForms>
		<!-- CS0649: some model fields are only written by the drawing side of the partial classes, which is not compiled here. -->
		<NoWarn>$(NoWarn);CS0649</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\C3D_Pro_Tools\CoverRoute.Model.cs" Link="Engine\CoverRoute.Model.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\CoverRules.cs" Link="Engine\CoverRules.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\CoverSolver.cs" Link="Engine\CoverSolver.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\CoverEvaluation.cs" Link="Engine\CoverEvaluation.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\NavisGeometryFit.cs" Link="Engine\NavisGeometryFit.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\NavisInterpreter.cs" Link="Engine\NavisInterpreter.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\NavisCatalogEditor.cs" Link="Engine\NavisCatalogEditor.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\NavisTransform.cs" Link="Engine\NavisTransform.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\PlanGeometry.cs" Link="Engine\PlanGeometry.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\ProfileViewMath.cs" Link="Engine\ProfileViewMath.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\LabelLayout.cs" Link="Engine\LabelLayout.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\NetworkMerge.cs" Link="Engine\NetworkMerge.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\RimRules.cs" Link="Engine\RimRules.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\ArrangeCase.cs" Link="Engine\ArrangeCase.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\SheetRefs.cs" Link="Engine\SheetRefs.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\BatchTargets.cs" Link="Engine\BatchTargets.cs" />
		<Compile Include="..\..\C3D_Pro_Tools\FormCoverPreview.cs" Link="Forms\FormCoverPreview.cs" />
		<!-- Contracts: compiled here, where no Autodesk assembly is referenced, so an Autodesk dependency fails the build. -->
		<Compile Include="..\..\C3D_Pro_Tools\Features\Networks\Contracts\**\*.cs" Link="Contracts\Networks\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- Application layer: also free of Autodesk types (it reaches the drawing only through ISplitDrawingAccess). -->
		<Compile Include="..\..\C3D_Pro_Tools\Features\Networks\Application\**\*.cs" Link="Application\Networks\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\Shared\NavisLinkProtocol.cs" Link="Engine\NavisLinkProtocol.cs" />
		<Compile Include="..\..\Shared\C3DProLogger.cs" Link="Engine\C3DProLogger.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Arrangement cases exported from real sheets (Annotation Studio, "Export arrangement case"), replayed by ArrangeCaseTests. -->
		<None Include="Cases\**\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>
</Project>
