{
    // Run with Ctrl+Shift+B (default build) or Terminal > Run Task...
    // The installer tasks run build.ps1, which builds everything (the WiX v5 installer included) with
    // the `dotnet` CLI and then runs the tests.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Plugin (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/C3D_Pro_Tools/C3D_Pro_Tools.csproj", "-c", "Debug"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Plugin + Installer (Release)",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Configuration", "Release"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Rebuild Plugin + Installer (Release)",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Configuration", "Release", "-Rebuild"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Plugin + Installer (Debug)",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Configuration", "Debug"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Install C3D Pro Tools (Release MSI)",
            "type": "process",
            "command": "msiexec.exe",
            "args": ["/i", "${workspaceFolder}\\C3DProInstaller\\bin\\Release\\C3DProInstaller.msi"],
            "dependsOn": "Build Plugin + Installer (Release)",
            "problemMatcher": []
        },
        {
            // Close Civil 3D first: it locks the DLL. After this, the bridge loads every time Civil 3D starts.
            "label": "Install C3D Bridge (agents <-> live Civil 3D)",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/C3DProTools.Bridge/Install-Bridge.ps1"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Check C3D Bridge is reachable",
            "type": "process",
            "command": "curl.exe",
            "args": ["-s", "-X", "POST", "http://127.0.0.1:47321/mcp", "-H", "Content-Type: application/json",
                     "-d", "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}"],
            "problemMatcher": []
        }
    ]
}
