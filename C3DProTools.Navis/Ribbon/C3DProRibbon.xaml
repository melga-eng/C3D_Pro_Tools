<?xml version="1.0" encoding="utf-8"?>
<!-- The C3D Pro tab in Navisworks. Button text, icons and tooltips come from the [Command] attributes of C3DProRibbon. -->
<RibbonControl
    x:Uid="C3DProRibbon"
    xmlns="clr-namespace:Autodesk.Windows;assembly=AdWindows"
    xmlns:local="clr-namespace:Autodesk.Navisworks.Gui.Roamer.AIRLook;assembly=navisworks.gui.roamer"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <RibbonTab Id="ID_C3DPro_Tab" KeyTip="C">
    <RibbonPanel x:Uid="C3DPro_Panel_Clashes">
      <RibbonPanelSource x:Uid="C3DPro_PanelSource_Clashes" Title="Clashes">
        <local:NWRibbonButton x:Uid="C3DPro_ClashGrouper" Id="ID_C3DPro_ClashGrouper" Size="Large" ShowText="True" Orientation="Vertical" />
      </RibbonPanelSource>
    </RibbonPanel>
    <RibbonPanel x:Uid="C3DPro_Panel_Civil">
      <RibbonPanelSource x:Uid="C3DPro_PanelSource_Civil" Title="Civil 3D">
        <local:NWRibbonButton x:Uid="C3DPro_CivilLink" Id="ID_C3DPro_CivilLink" Size="Large" ShowText="True" Orientation="Vertical" />
      </RibbonPanelSource>
    </RibbonPanel>
  </RibbonTab>
</RibbonControl>
