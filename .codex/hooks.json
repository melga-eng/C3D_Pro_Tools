{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE '\"file_path\": *\"[^\"]*\\.cs\"' && \"C:/Users/melga/.local/bin/graphify.exe\" update \"$CLAUDE_PROJECT_DIR\" >/dev/null 2>&1; exit 0",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
