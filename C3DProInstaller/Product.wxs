<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

	<!-- Keep the UpgradeCode unchanged: MajorUpgrade uses it to remove earlier installs (the WiX v3 x86 packages up to 1.1.0
	     included, and the old Civil3DStyleManager.bundle folder) before installing this version. -->
	<Package Name="C3D Pro Tools" Language="1033" Version="1.1.0.0" Manufacturer="Mohamed Elgarhy" UpgradeCode="f1e2d3c4-b5a6-4789-8c9d-0e1f2a3b4c5d"
	         InstallerVersion="500" Scope="perMachine" Compressed="yes">

		<!-- AllowSameVersionUpgrades: a rebuild keeps Version 1.1.0.0, so without it the new MSI installs beside the old one
		     and Windows Installer keeps the old C3D_Pro_Tools.dll (same file version = not replaced). With it, the old
		     install is removed first, so every new build's DLL is always copied in. -->
		<MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<!-- Never together with the public edition (same plugin assembly and command names: only one would load). -->
		<Upgrade Id="c54742b5-1e7f-479f-b6f1-3e382de332ce">
			<UpgradeVersion Minimum="0.0.0.0" IncludeMinimum="yes" OnlyDetect="yes" Property="PUBLICEDITIONFOUND" />
		</Upgrade>
		<Launch Condition="NOT PUBLICEDITIONFOUND OR Installed" Message="The public C3D Pro Tools is installed on this computer. Uninstall it first (Settings, Apps), then run this installer again." />

		<Feature Id="ProductFeature" Title="C3D Pro Tools" Level="1">
			<ComponentGroupRef Id="PluginComponents" />
			<ComponentGroupRef Id="NavisworksComponents" />
		</Feature>
	</Package>

	<Fragment>
		<!-- Installs to: C:\ProgramData\Autodesk\ApplicationPlugins\C3DProTools.bundle\Contents -->
		<StandardDirectory Id="CommonAppDataFolder">
			<Directory Id="AutodeskFolder" Name="Autodesk">
				<!-- Navisworks loads per-machine add-ins from C:\ProgramData\Autodesk\Navisworks Manage 2026\Plugins\<Name>\<Name>.dll -->
				<Directory Id="NavisManageFolder" Name="Navisworks Manage 2026">
					<Directory Id="NavisPluginsFolder" Name="Plugins">
						<Directory Id="NavisAddinFolder" Name="C3DProTools.Navis"><Directory Id="NavisAddinEnUsFolder" Name="en-US" /></Directory>
					</Directory>
				</Directory>
				<Directory Id="ApplicationPluginsFolder" Name="ApplicationPlugins">
					<Directory Id="BundleFolder" Name="C3DProTools.bundle">
						<Directory Id="ContentsFolder" Name="Contents" />
					</Directory>
				</Directory>
			</Directory>
		</StandardDirectory>
	</Fragment>

	<Fragment>
		<ComponentGroup Id="PluginComponents">

			<!-- Component 1: The PackageContents.xml file -->
			<Component Id="PackageContentsXml" Directory="BundleFolder">
				<File Id="PackageContentsFile" Name="PackageContents.xml" Source="$(sys.SOURCEFILEDIR)PackageContents.xml" KeyPath="yes" />
			</Component>

			<!-- Component 2: The compiled plugin, from the C3D_Pro_Tools project's build output -->
			<Component Id="PluginDLL" Directory="ContentsFolder">
				<File Id="DllFile" Name="C3D_Pro_Tools.dll" Source="$(var.C3D_Pro_Tools.TargetPath)" KeyPath="yes" />
			</Component>

		</ComponentGroup>

		<!-- Navisworks Manage 2026 add-in: answers the Civil 3D Navisworks Import over a local link. -->
		<ComponentGroup Id="NavisworksComponents">
			<Component Id="NavisAddinDLL" Directory="NavisAddinFolder">
				<File Id="NavisDllFile" Name="C3DProTools.Navis.dll" Source="$(var.C3DProTools.Navis.TargetPath)" KeyPath="yes" />
				<File Id="NavisRibbonXaml" Name="C3DProRibbon.xaml" Source="$(var.C3DProTools.Navis.TargetDir)C3DProRibbon.xaml" />
				<File Id="NavisIconGrouper16" Name="ClashGrouper_16.png" Source="$(var.C3DProTools.Navis.TargetDir)ClashGrouper_16.png" />
				<File Id="NavisIconGrouper32" Name="ClashGrouper_32.png" Source="$(var.C3DProTools.Navis.TargetDir)ClashGrouper_32.png" />
				<File Id="NavisIconLink16" Name="CivilLink_16.png" Source="$(var.C3DProTools.Navis.TargetDir)CivilLink_16.png" />
				<File Id="NavisIconLink32" Name="CivilLink_32.png" Source="$(var.C3DProTools.Navis.TargetDir)CivilLink_32.png" />
			</Component>
			<Component Id="NavisRibbonEnUs" Directory="NavisAddinEnUsFolder">
				<File Id="NavisRibbonXamlEnUs" Name="C3DProRibbon.xaml" Source="$(var.C3DProTools.Navis.TargetDir)en-US\C3DProRibbon.xaml" KeyPath="yes" />
			</Component>
		</ComponentGroup>
	</Fragment>
</Wix>
