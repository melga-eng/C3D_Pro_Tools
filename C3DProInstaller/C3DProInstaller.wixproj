<Project Sdk="WixToolset.Sdk/5.0.2">
	<!-- SDK-style WiX v5 project: `dotnet build` builds the plugin, the Navisworks add-in and this MSI in one go
	     (no Visual Studio MSBuild or WiX v3 install needed). The NuGet package WixToolset.Sdk is restored like any other. -->
	<PropertyGroup>
		<OutputName>C3DProInstaller</OutputName>
		<!-- A 64-bit package (Civil 3D and Navisworks are 64-bit only), whatever platform the solution builds. -->
		<InstallerPlatform>x64</InstallerPlatform>
		<!-- bin\Release\C3DProInstaller.msi, where the earlier installer and the install task put it. -->
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<!-- ICE61: MajorUpgrade allows the same version on purpose (every rebuild of 1.1.0.0 replaces the installed DLLs). -->
		<SuppressIces>ICE61</SuppressIces>
	</PropertyGroup>

	<ItemGroup>
		<None Include="PackageContents.xml" />
	</ItemGroup>

	<ItemGroup>
		<!-- Built first; their outputs are found through $(var.<Project>.TargetPath) in Product.wxs. -->
		<ProjectReference Include="..\C3D_Pro_Tools\C3D_Pro_Tools.csproj" />
		<ProjectReference Include="..\C3DProTools.Navis\C3DProTools.Navis.csproj" />
	</ItemGroup>
</Project>
